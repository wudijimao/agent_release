{
  "name": "@bioagent/nextjs",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "browserslist": [
    "chrome 111",
    "edge 111",
    "firefox 111",
    "safari 16.4"
  ],
  "scripts": {
    "predev": "pnpm --filter @bioagent/chatui build",
    "dev": "next dev",
    "prebuild": "pnpm --filter @bioagent/chatui build && pnpm --filter @bioagent/shared build",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src next.config.ts",
    "release:check": "pnpm build && pnpm test && pnpm lint",
    "test": "node --import tsx --test src/**/*.test.ts",
    "test:visual": "pnpm build && node visual-tests/run.mjs",
    "test:visual:update": "pnpm build && node visual-tests/run.mjs --update-snapshots",
    "test:visual:existing": "node visual-tests/run.mjs",
    "test:visual:install": "playwright install chromium"
  },
  "dependencies": {
    "@bioagent/chatui": "workspace:*",
    "@bioagent/shared": "workspace:*",
    "firebase": "^12.17.0",
    "lucide-react": "1.21.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/node": "^20",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "10.4.21",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "postcss": "8.5.10",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.0",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.23.0"
}
